<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical" android:background="#000000">
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="#161616" app:tabMode="scrollable" app:tabGravity="center"
        app:tabTextColor="#CCCCCC" app:tabSelectedTextColor="#FF8A25" app:tabIndicatorColor="#FF8A25" />
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
